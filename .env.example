# Copy this file to .env. Never commit .env.
# Use a provider that exposes an OpenAI-compatible chat-completions endpoint.
YOU_AGENT_API_KEY=replace_with_your_own_key
YOU_AGENT_BASE_URL=https://api.example.com/v1
YOU_AGENT_MODEL=replace_with_model_name

# Agent limits
YOU_AGENT_MAX_ROUNDS=10
YOU_AGENT_COMMAND_TIMEOUT_SECONDS=30
YOU_AGENT_CONTEXT_BUDGET_TOKENS=32000
YOU_AGENT_COMPRESSION_TRIGGER_PERCENT=80

# Optional paths. Relative paths stay inside the current workspace.
# YOU_AGENT_MEMORY_FILE=.you-agent/memory.jsonl
# YOU_AGENT_INDEX_FILE=.you-agent/code-index.db

# Optional OpenAI-compatible embeddings. If any field is missing, the deterministic
# offline Feature Hash baseline remains active.
# YOU_AGENT_EMBEDDING_API_KEY=replace_with_your_own_embedding_key
# YOU_AGENT_EMBEDDING_BASE_URL=https://api.example.com/v1
# YOU_AGENT_EMBEDDING_MODEL=replace_with_embedding_model
YOU_AGENT_FEATURE_HASH_DIMENSIONS=256
